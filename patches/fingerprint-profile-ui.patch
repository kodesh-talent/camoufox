diff --git a/browser/modules/CamoufoxFingerprint.sys.mjs b/browser/modules/CamoufoxFingerprint.sys.mjs
new file mode 100755
index 0000000000..c2c504ea87
--- /dev/null
+++ b/browser/modules/CamoufoxFingerprint.sys.mjs
@@ -0,0 +1,216 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+const FINGERPRINT_FILENAME = "camoufox-fingerprint.json";
+const MAX_FINGERPRINT_FILE_SIZE = 4 * 1024 * 1024;
+
+function browserMajor() {
+  return Number.parseInt(Services.appinfo.version, 10);
+}
+
+function profileFingerprintPath() {
+  return PathUtils.join(PathUtils.profileDir, FINGERPRINT_FILENAME);
+}
+
+function createDocument(fingerprint, createdAt = new Date().toISOString()) {
+  return {
+    format: "camoufox-fingerprint",
+    schemaVersion: 1,
+    browserMajor: browserMajor(),
+    createdAt,
+    fingerprint,
+  };
+}
+
+function canonicalizeDocument(document) {
+  const fingerprintJSON = ChromeUtils.camouCanonicalizeFingerprintJSON(
+    typeof document == "string" ? document : JSON.stringify(document),
+    browserMajor()
+  );
+  return JSON.parse(fingerprintJSON);
+}
+
+function clearLaunchFingerprintEnvironment() {
+  const environment = Cc[
+    "@mozilla.org/process/environment;1"
+  ].getService(Ci.nsIEnvironment);
+  environment.set("CAMOU_CONFIG", "");
+  for (let index = 1; ; ++index) {
+    const name = `CAMOU_CONFIG_${index}`;
+    if (!environment.exists(name)) {
+      break;
+    }
+    environment.set(name, "");
+  }
+}
+
+function restart() {
+  Services.startup.quit(
+    Ci.nsIAppStartup.eAttemptQuit | Ci.nsIAppStartup.eRestart
+  );
+}
+
+async function localize(document, id, args) {
+  return document.l10n.formatValue(id, args);
+}
+
+async function alertError(window, error) {
+  const [title, message] = await Promise.all([
+    localize(window.document, "camoufox-fingerprint-error-title"),
+    localize(window.document, "camoufox-fingerprint-error-message", {
+      error: error.message,
+    }),
+  ]);
+  Services.prompt.alert(window, title, message);
+}
+
+async function pickFile(window, mode) {
+  const saving = mode == Ci.nsIFilePicker.modeSave;
+  const ids = saving
+    ? [
+        "camoufox-fingerprint-export-picker-title",
+        "camoufox-fingerprint-export-picker-button",
+      ]
+    : [
+        "camoufox-fingerprint-import-picker-title",
+        "camoufox-fingerprint-import-picker-button",
+      ];
+  const [title, button, filter] = await Promise.all([
+    localize(window.document, ids[0]),
+    localize(window.document, ids[1]),
+    localize(window.document, "camoufox-fingerprint-json-filter"),
+  ]);
+  const picker = Cc["@mozilla.org/filepicker;1"].createInstance(
+    Ci.nsIFilePicker
+  );
+  picker.init(window.browsingContext, title, mode);
+  picker.appendFilter(filter, "*.json");
+  picker.appendFilters(Ci.nsIFilePicker.filterAll);
+  picker.okButtonLabel = button;
+  if (saving) {
+    picker.defaultExtension = "json";
+    picker.defaultString = `camoufox-fingerprint-${new Date()
+      .toISOString()
+      .slice(0, 10)}.json`;
+  }
+  const result = await new Promise(resolve => picker.open(resolve));
+  return result == Ci.nsIFilePicker.returnCancel ? null : picker.file.path;
+}
+
+async function confirmRestart(window, messageId) {
+  const [title, message] = await Promise.all([
+    localize(window.document, "camoufox-fingerprint-restart-title"),
+    localize(window.document, messageId),
+  ]);
+  return Services.prompt.confirm(window, title, message);
+}
+
+async function writeFingerprint(path, document) {
+  canonicalizeDocument(document);
+  const bytes = new TextEncoder().encode(`${JSON.stringify(document, null, 2)}\n`);
+  if (bytes.length > MAX_FINGERPRINT_FILE_SIZE) {
+    throw new Error("fingerprint file exceeds 4 MiB");
+  }
+  await IOUtils.write(path, bytes, { tmpPath: `${path}.tmp`, flush: true });
+}
+
+export async function exportFingerprint(path) {
+  const fingerprint = JSON.parse(ChromeUtils.camouGetFingerprintJSON());
+  await writeFingerprint(path, createDocument(fingerprint));
+}
+
+export async function readFingerprint(path) {
+  const stat = await IOUtils.stat(path);
+  if (stat.size > MAX_FINGERPRINT_FILE_SIZE) {
+    throw new Error("fingerprint file exceeds 4 MiB");
+  }
+  return canonicalizeDocument(await IOUtils.readUTF8(path));
+}
+
+/**
+ * Persist a validated fingerprint for the current profile. Import uses this
+ * entry point; a future generator can call the same function with its final
+ * fingerprint instead of introducing another persistence path.
+ */
+export async function bindFingerprint(
+  fingerprint,
+  { createdAt = new Date().toISOString(), restartBrowser = true } = {}
+) {
+  const canonical = canonicalizeDocument(createDocument(fingerprint, createdAt));
+  const document = createDocument(canonical, createdAt);
+  const path = profileFingerprintPath();
+  await writeFingerprint(path, document);
+  if (restartBrowser) {
+    restart();
+  }
+}
+
+export const CamoufoxFingerprint = {
+  async isBound() {
+    return IOUtils.exists(profileFingerprintPath());
+  },
+
+  async updateMenu(document) {
+    const clearButton = document.getElementById(
+      "appMenu-camoufox-fingerprint-clear"
+    );
+    if (clearButton) {
+      clearButton.disabled = !(await this.isBound());
+    }
+  },
+
+  async exportCurrent(window) {
+    try {
+      const path = await pickFile(window, Ci.nsIFilePicker.modeSave);
+      if (!path) {
+        return;
+      }
+      await exportFingerprint(path);
+    } catch (error) {
+      await alertError(window, error);
+    }
+  },
+
+  async importAndRestart(window) {
+    try {
+      const path = await pickFile(window, Ci.nsIFilePicker.modeOpen);
+      if (!path) {
+        return;
+      }
+      const fingerprint = await readFingerprint(path);
+      if (
+        !(await confirmRestart(
+          window,
+          "camoufox-fingerprint-import-restart-message"
+        ))
+      ) {
+        return;
+      }
+      await bindFingerprint(fingerprint);
+    } catch (error) {
+      await alertError(window, error);
+    }
+  },
+
+  async clearAndRestart(window) {
+    try {
+      if (!(await this.isBound())) {
+        return;
+      }
+      if (
+        !(await confirmRestart(
+          window,
+          "camoufox-fingerprint-clear-restart-message"
+        ))
+      ) {
+        return;
+      }
+      await IOUtils.remove(profileFingerprintPath(), { ignoreAbsent: true });
+      clearLaunchFingerprintEnvironment();
+      restart();
+    } catch (error) {
+      await alertError(window, error);
+    }
+  },
+};
