diff --git a/browser/modules/test/unit/test_CamoufoxFingerprint.js b/browser/modules/test/unit/test_CamoufoxFingerprint.js
new file mode 100755
index 0000000000..d64b07b437
--- /dev/null
+++ b/browser/modules/test/unit/test_CamoufoxFingerprint.js
@@ -0,0 +1,85 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+const { bindFingerprint, CamoufoxFingerprint } = ChromeUtils.importESModule(
+  "resource:///modules/CamoufoxFingerprint.sys.mjs"
+);
+
+const BROWSER_MAJOR = Number.parseInt(Services.appinfo.version, 10);
+
+function documentWith(fingerprint, overrides = {}) {
+  return JSON.stringify({
+    format: "camoufox-fingerprint",
+    schemaVersion: 1,
+    browserMajor: BROWSER_MAJOR,
+    createdAt: "2026-09-29T00:00:00.000Z",
+    fingerprint,
+    ...overrides,
+  });
+}
+
+add_task(function test_canonicalizes_safe_fingerprint() {
+  const result = JSON.parse(
+    ChromeUtils.camouCanonicalizeFingerprintJSON(
+      documentWith({
+        "navigator.language": "zh-CN",
+        "screen.width": 1920,
+        "webGl:parameters": { 3379: 16384 },
+      }),
+      BROWSER_MAJOR
+    )
+  );
+  Assert.deepEqual(result, {
+    "navigator.language": "zh-CN",
+    "screen.width": 1920,
+    "webGl:parameters": { 3379: 16384 },
+  });
+});
+
+add_task(function test_rejects_runtime_control_properties() {
+  Assert.throws(
+    () =>
+      ChromeUtils.camouCanonicalizeFingerprintJSON(
+        documentWith({ addons: ["malicious.xpi"] }),
+        BROWSER_MAJOR
+      ),
+    /not allowed/
+  );
+});
+
+add_task(function test_rejects_wrong_browser_major() {
+  Assert.throws(
+    () =>
+      ChromeUtils.camouCanonicalizeFingerprintJSON(
+        documentWith(
+          { "navigator.language": "zh-CN" },
+          { browserMajor: BROWSER_MAJOR + 1 }
+        ),
+        BROWSER_MAJOR
+      ),
+    /major version/
+  );
+});
+
+add_task(async function test_binding_round_trip_and_clear_state() {
+  do_get_profile();
+  await bindFingerprint(
+    {
+      "navigator.language": "zh-CN",
+      "screen.width": 1920,
+    },
+    { createdAt: "2026-09-29T00:00:00.000Z", restartBrowser: false }
+  );
+  Assert.ok(await CamoufoxFingerprint.isBound());
+  const stored = await IOUtils.readJSON(
+    PathUtils.join(PathUtils.profileDir, "camoufox-fingerprint.json")
+  );
+  Assert.equal(stored.format, "camoufox-fingerprint");
+  Assert.equal(stored.schemaVersion, 1);
+  Assert.equal(stored.browserMajor, BROWSER_MAJOR);
+  Assert.deepEqual(stored.fingerprint, {
+    "navigator.language": "zh-CN",
+    "screen.width": 1920,
+  });
+});
