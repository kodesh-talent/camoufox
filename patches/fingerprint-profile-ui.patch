+static nsresult LoadCamoufoxProfileFingerprint(nsIFile* aProfileDir) {
+  nsCOMPtr<nsIFile> fingerprintFile;
+  nsresult rv = aProfileDir->Clone(getter_AddRefs(fingerprintFile));
+  NS_ENSURE_SUCCESS(rv, rv);
+  rv = fingerprintFile->AppendNative("camoufox-fingerprint.json"_ns);
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  bool exists = false;
+  rv = fingerprintFile->Exists(&exists);
+  NS_ENSURE_SUCCESS(rv, rv);
+  if (!exists) {
+    return NS_OK;
+  }
+
+  int64_t fileSize = 0;
+  rv = fingerprintFile->GetFileSize(&fileSize);
+  NS_ENSURE_SUCCESS(rv, rv);
+  if (fileSize <= 0 || fileSize > 4 * 1024 * 1024) {
+    Output(true,
+           "The profile fingerprint file is empty or exceeds the 4 MiB limit. "
+           "Remove camoufox-fingerprint.json from the profile to recover.\n");
+    fflush(stderr);
+    return NS_ERROR_FILE_CORRUPTED;
+  }
+
+  PRFileDesc* fileDesc = nullptr;
+  rv = fingerprintFile->OpenNSPRFileDesc(PR_RDONLY, 0, &fileDesc);
+  NS_ENSURE_SUCCESS(rv, rv);
+  if (!fileDesc) {
+    return NS_ERROR_FILE_NOT_FOUND;
+  }
+
+  nsAutoCString documentJSON;
+  documentJSON.SetLength(static_cast<uint32_t>(fileSize));
+  int32_t bytesRead = PR_Read(fileDesc, documentJSON.BeginWriting(),
+                              static_cast<int32_t>(fileSize));
+  PR_Close(fileDesc);
+  if (bytesRead != fileSize) {
+    return NS_ERROR_FILE_CORRUPTED;
+  }
+
